---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { filterArticles } from "@/utils/filterArticles";
import { fetchMediumPosts } from "@/utils/medium";
import Header from "@/components/Header.astro";
import ArticleWindow from "@/components/ArticleWindow";
import Projects from "@/components/Projects.astro";
import Products from "@/components/Products.astro";

const allMedium = await fetchMediumPosts();
const allArticlesFresh = await getCollection("article");
const allArticles = await filterArticles(allArticlesFresh, "recent", null);
const [projectsEntry] = await getCollection("projects");
const allProjects = projectsEntry?.data.projects ?? [];
const [productsEntry] = await getCollection("products");
const allProducts = productsEntry?.data.products ?? [];
---

<BaseLayout>
  <Header />
  <main class="main-layout px-4 pt-20 mb-16">
    <section class="grid gap-4 mt-10">
      <div class="flex justify-center">
        <img
          class="w-[142px] rounded-full"
          loading="lazy"
          src="./assets/profile_picture.png"
          alt=""
        />
      </div>
      <div class="grid gap-2 max-w-[35rem] mx-auto">
        <h1 class="text-center font-semibold text-3xl text-white">Aidil Iskandar</h1>
        <p class="text-center text-lg">
          I’m a student aspiring physicist who also enjoys programming, and this is where I share my
          projects, thoughts, and learning journey in physics and technology.
        </p>
      </div>
      <div class="grid justify-center">
        <ul class="flex gap-4">
          <li>
            <a
              aria-label="linkedin-link"
              class="hover:text-white"
              href="https://www.linkedin.com/in/muhammad-aidil-iskandar/"
              target="_blank"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z"
                ></path></svg
              >
            </a>
          </li>
          <li>
            <a
              class="hover:text-white"
              href="https://thisisaidil.medium.com/"
              target="_blank"
              aria-label="medium-link"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 24 24"
                ><path
                  fill="currentColor"
                  fill-rule="evenodd"
                  d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12s4.48 10 10 10s10-4.481 10-10m-8.996 0c0 2.458-1.98 4.45-4.42 4.45c-2.442 0-4.421-1.992-4.421-4.45s1.98-4.451 4.42-4.451c2.442 0 4.421 1.993 4.421 4.45m4.85 0c0 2.314-.99 4.19-2.21 4.19c-1.222 0-2.211-1.876-2.211-4.19s.99-4.19 2.21-4.19s2.21 1.875 2.21 4.19m1.983 0c0 2.072-.348 3.754-.777 3.754s-.778-1.681-.778-3.754s.348-3.754.778-3.754c.429 0 .777 1.68.777 3.754"
                  clip-rule="evenodd"></path></svg
              >
            </a>
          </li>
          <li>
            <a
              class="hover:text-white"
              href="https://github.com/aidil-sekandar"
              target="_blank"
              aria-label="github-link"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="2em" height="2em" viewBox="0 0 24 24">
                <rect width="24" height="24" fill="none"></rect>
                <path
                  fill="currentColor"
                  d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2"
                ></path>
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <!-- <section class="mb-6 mt-10 bg-cardColor p-9 rounded-2xl">
      <div class="grid gap-1 mb-4">
        <h2 class="text-white font-semibold text-xl">Subscribe to My Newsletter</h2>
        <p>
          Stay updated as I share insights on STEM, personal reflections, and practical guidance for
          students navigating their educational journey.
        </p>
      </div>
      <form class="mx-auto flex gap-x-4">
        <label for="email-address" class="sr-only">Email address</label>
        <input
          id="email-address"
          name="email"
          type="email"
          autocomplete="email"
          required=""
          class="min-w-0 flex-auto rounded-md border-0 bg-white/5 px-3.5 py-2 text-white shadow-sm ring-1 ring-inset ring-white/10 focus:ring-2 focus:ring-inset focus:ring-white sm:text-sm sm:leading-6"
          placeholder="Enter your email"
        />

        <button
          type="submit"
          class="flex-none rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-[#0178e8] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white duration-100 hover:text-white"
          >Notify me</button
        >
      </form>
      <p class="text-center text-xs mt-3 text-[#ffffff59]">
        No spam, no sharing to third party. Only you and me.
      </p>
    </section> -->

    <section class="mt-16">
      <h2 class="text-white text-3xl font-semibold mb-4 flex items-center gap-2">
        Checkout my projects
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="m22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9c-2-2-5-2.4-7.4-1.3L9 6L6 9L1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4"
          ></path>
        </svg>
      </h2>
      <div class="grid sm:grid-cols-2 gap-5 auto-rows-fr">
        {
          allProjects.map((project) => {
            return <Projects {...project} />;
          })
        }
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-white text-3xl font-semibold mb-4 flex items-center gap-2">
        Purchase my products
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
          <path
            fill="currentColor"
            d="M19 6h-2c0-2.8-2.2-5-5-5S7 3.2 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2m-7-3c1.7 0 3 1.3 3 3H9c0-1.7 1.3-3 3-3m7 17H5V8h14zm-7-8c-1.7 0-3-1.3-3-3H7c0 2.8 2.2 5 5 5s5-2.2 5-5h-2c0 1.7-1.3 3-3 3"
          ></path>
        </svg>
      </h2>
      <div class="grid sm:grid-cols-2 gap-5 auto-rows-fr">
        {
          allProducts.map((product) => {
            return <Products {...product} />;
          })
        }
      </div>
    </section>

    <section class="mt-12">
      <div
        class="rounded-2xl p-6 md:p-8 grid gap-4 border border-[#FFDD0059] bg-[linear-gradient(135deg,rgba(255,221,0,0.16),rgba(255,221,0,0.04)_38%,rgba(35,36,41,0.88)_100%)] backdrop-blur-sm shadow-[0_8px_30px_rgba(255,221,0,0.08)]"
      >
        <h2 class="text-white text-2xl font-semibold">Support My Works</h2>
        <p>
          If my works have been helpful to you, and you would like to support what I do, you can buy
          me a coffee. Your support is genuinely appreciated and helps me keep building and sharing.
        </p>
        <div>
          <a
            href="https://buymeacoffee.com/aidilskndrr"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-md py-3 px-5 border-2 border-[#FFDD0080] text-white bg-[#FFDD001A] hover:bg-[#FFDD0030] duration-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
              <path
                fill="currentColor"
                d="m20.216 6.415l-.132-.666c-.119-.598-.388-1.163-1.001-1.379c-.197-.069-.42-.098-.57-.241c-.152-.143-.196-.366-.231-.572c-.065-.378-.125-.756-.192-1.133c-.057-.325-.102-.69-.25-.987c-.195-.4-.597-.634-.996-.788a6 6 0 0 0-.626-.194c-1-.263-2.05-.36-3.077-.416a26 26 0 0 0-3.7.062c-.915.083-1.88.184-2.75.5c-.318.116-.646.256-.888.501c-.297.302-.393.77-.177 1.146c.154.267.415.456.692.58c.36.162.737.284 1.123.366c1.075.238 2.189.331 3.287.37q1.829.074 3.65-.118q.449-.05.896-.119c.352-.054.578-.513.474-.834c-.124-.383-.457-.531-.834-.473c-.466.074-.96.108-1.382.146q-1.767.12-3.536.006a22 22 0 0 1-1.157-.107c-.086-.01-.18-.025-.258-.036q-.364-.055-.724-.13c-.111-.027-.111-.185 0-.212h.005q.416-.09.838-.147h.002c.131-.009.263-.032.394-.048a25 25 0 0 1 3.426-.12q1.011.029 2.017.144l.228.031q.4.06.798.145c.392.085.895.113 1.07.542c.055.137.08.288.111.431l.319 1.484a.237.237 0 0 1-.199.284h-.003l-.112.015a37 37 0 0 1-4.743.295a37 37 0 0 1-4.699-.304c-.14-.017-.293-.042-.417-.06c-.326-.048-.649-.108-.973-.161c-.393-.065-.768-.032-1.123.161c-.29.16-.527.404-.675.701c-.154.316-.199.66-.267 1c-.069.34-.176.707-.135 1.056c.087.753.613 1.365 1.37 1.502a39.7 39.7 0 0 0 11.343.376a.483.483 0 0 1 .535.53l-.071.697l-1.018 9.907c-.041.41-.047.832-.125 1.237c-.122.637-.553 1.028-1.182 1.171q-.868.197-1.756.205c-.656.004-1.31-.025-1.966-.022c-.699.004-1.556-.06-2.095-.58c-.475-.458-.54-1.174-.605-1.793l-.731-7.013l-.322-3.094c-.037-.351-.286-.695-.678-.678c-.336.015-.718.3-.678.679l.228 2.185l.949 9.112c.147 1.344 1.174 2.068 2.446 2.272c.742.12 1.503.144 2.257.156c.966.016 1.942.053 2.892-.122c1.408-.258 2.465-1.198 2.616-2.657l1.024-9.995l.215-2.087a.48.48 0 0 1 .39-.426c.402-.078.787-.212 1.074-.518c.455-.488.546-1.124.385-1.766zm-1.478.772c-.145.137-.363.201-.578.233c-2.416.359-4.866.54-7.308.46c-1.748-.06-3.477-.254-5.207-.498c-.17-.024-.353-.055-.47-.18c-.22-.236-.111-.71-.054-.995c.052-.26.152-.609.463-.646c.484-.057 1.046.148 1.526.22q.865.132 1.737.212c2.48.226 5.002.19 7.472-.14q.675-.09 1.345-.21c.399-.072.84-.206 1.08.206c.166.281.188.657.162.974a.54.54 0 0 1-.169.364zm-6.159 3.9c-.862.37-1.84.788-3.109.788a6 6 0 0 1-1.569-.217l.877 9.004c.065.78.717 1.38 1.5 1.38c0 0 1.243.065 1.658.065c.447 0 1.786-.065 1.786-.065c.783 0 1.434-.6 1.499-1.38l.94-9.95a4 4 0 0 0-1.322-.238c-.826 0-1.491.284-2.26.613"
              ></path>
            </svg>
            Buy me a coffee
          </a>
        </div>
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-white text-3xl font-semibold mb-4">Thoughts</h2>
      <ArticleWindow client:load allArticles={allArticles} allMedium={allMedium} />
    </section>
  </main>
</BaseLayout>

<style>
  body {
    background-color: #0d0e11 !important;
    color: #abadba !important;
  }
</style>
